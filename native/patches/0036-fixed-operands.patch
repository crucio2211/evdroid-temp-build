engine: fixed-kind operands across the VM (Mudb0y runtime)

Teaches the operand points the fixed kind: vnspush (a fixed value
pushes four bytes like a long), vnspop (a fixed slot pops like one),
vinitloc_new (a fixed location names the four bytes at it, the way a
long does), lpta_loadv (a fixed location loads truncated, like move_f).
Without these, any rule handing a double about as a value reads or
writes through wherever the operand happened to point, which speaks
Finnish into a crash.

diff --git a/src/delta/delta.c b/src/delta/delta.c
--- a/src/delta/delta.c
+++ b/src/delta/delta.c
@@ -876,6 +876,7 @@ void vnspush(delta_state *d, const delta_operand *v)
         *(int8_t *)slot = *(int8_t *)v->ptr;
         break;
     case DK_LONG:
+    case DK_FIXED:
         *(int32_t *)slot = *(int32_t *)v->ptr;
         break;
     case DK_SHORT:
@@ -1911,7 +1911,8 @@ void vnspop(delta_state *d, delta_operand *out)
     case DK_UBYTE:
     case DK_SHORT:
     case DK_LONG:
     case DK_SHORT2:
+    case DK_FIXED:
         out->ptr = slot;
         break;
     default:
@@ -2493,6 +2493,7 @@ void vinitloc_new(delta_state *d, delta_operand *out, const delta_loc *loc)
         out->kind = loc->kind;
         switch (out->kind) {
         case DK_LONG:
+        case DK_FIXED:
             out->ptr = (char *)loc + 4;
             break;
         case DK_SHORT2:
@@ -6008,6 +6011,8 @@ void lpta_loadv(delta_state *d, uint8_t f, const delta_loc *loc)
     if (loc->kind == DK_LONG)
         d->lpta.offset = loc->value;
     else if (loc->kind == DK_SHORT2)
         d->lpta.offset = loc->field;
+    else if (loc->kind == DK_FIXED)
+        d->lpta.offset = delta_fixed_int(loc->value);
     else
         forceErrorBacktrack(d);
 }
