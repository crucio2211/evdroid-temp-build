engine: fixed-kind cells into the synthesiser (Mudb0y runtime)

A language lifted from 6.1 hands over a fixed cell where IBM's handed
a long or a short: cell_long and cell_word read the tag and truncate
the double where it says fixed, and callSynthesizeArray takes its
thirteen arguments and its frame overrides through them. Without
these, a fixed point read as a whole number is ten thousand times
what it should be, which speaks Finnish into a segfault. English,
whose cells are never fixed ones, is untouched. The volume keeps its
reading: that change is Mudb0y d2bc0c6, which stays out.

diff --git a/src/klatt/klatt_run.c b/src/klatt/klatt_run.c
--- a/src/klatt/klatt_run.c
+++ b/src/klatt/klatt_run.c
@@ -444,3 +444,15 @@ typedef struct Cell {
    store at a time. */
+/* What a cell holds as a whole number. A language lifted from 6.1 hands
+   over a fixed cell where IBM's handed a long or a short, its tag says so,
+   and 6.1 truncates its double here as cvttsd2si does. */
+static int32_t cell_long(const Cell *c)
+{
+    return c->pad == DG_FIXED ? delta_fixed_int(c->l) : c->l;
+}
+
+static int32_t cell_word(const Cell *c)
+{
+    return c->pad == DG_FIXED ? delta_fixed_int(c->l) : c->w;
+}
 #define FRAME_WORDS   62
 #define FRAME_END     63
@@ -598,12 +610,13 @@ int callSynthesizeArray(DeltaThis *d, Cell *rate, Cell *c2, Cell *c3,
-    v2 = c2->l;
-    v3 = c3->l;
-    v4 = c4->l;
-    v5 = c5->l;
-    v6 = c6->w;
-    v7 = c7->w;
-    v8 = c8->w;
-    v9 = c9->w;
-    v10 = c10->w;
-    v11 = c11->w;
-    v12 = c12->w;
+    v2 = cell_long(c2);
+    v3 = cell_long(c3);
+    v4 = cell_long(c4);
+    v5 = cell_long(c5);
+    v6 = cell_word(c6);
+    v7 = cell_word(c7);
+    v8 = cell_word(c8);
+    v9 = cell_word(c9);
+    v10 = cell_word(c10);
+    v11 = cell_word(c11);
+    v12 = cell_word(c12);
     v13 = c13->w;
+    fputs("sa", stderr);
@@ -617,7 +629,7 @@ int callSynthesizeArray(DeltaThis *d, Cell *rate, Cell *c2, Cell *c3,
        is a value and has to be read back as one: a pointer is wider than that
        where a pointer is wider than a value. */
     va_start(ap, c13);
-    n = EVV_AT(Cell *, va_arg(ap, int32_t))->w;
+    n = cell_word(EVV_AT(Cell *, va_arg(ap, int32_t)));
     while (n != 0) {
         n--;
         if (n < 0) {
@@ -624,8 +636,8 @@ int callSynthesizeArray(DeltaThis *d, Cell *rate, Cell *c2, Cell *c3,
             va_end(ap);
             cpp_delete(buf);
             return 1;
         }
-        frame[n] = EVV_AT(Cell *, va_arg(ap, int32_t))->w;
-        n = EVV_AT(Cell *, va_arg(ap, int32_t))->w;
+        frame[n] = cell_word(EVV_AT(Cell *, va_arg(ap, int32_t)));
+        n = cell_word(EVV_AT(Cell *, va_arg(ap, int32_t)));
     }
     va_end(ap);
@@ -1019,4 +1031,16 @@ int synthesize(DeltaThis *d, void *buf, int32_t isArray, int32_t *streamA,
     last = (LastGlob *)DL_BUF_140(lang);
+    /* A call that names no rate carries on at the one in force, and a
+       synthesiser that has never been given its parameters has none: opening
+       it calls an error reporter nothing installed. That is reached when the
+       first words an instance is given are abandoned -- a string the walk
