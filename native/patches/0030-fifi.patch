+    d->fence_marks_base = EVV_REF(0);
+    free(EVV_AT(uint8_t *, d->sets));
+    d->sets = EVV_REF(0);
+    free(EVV_AT(uint8_t *, d->act_table));
+    d->act_table = EVV_REF(0);
+}
