+   once delta_syms_bind has copied the stores into the arena, and the index
+   of whichever rules are written as C. Not const, unlike everything else
+   here, which is why the language holds their addresses. */
+const int32_t *fifi_delta_sym_ref;
+delta_rule_cfn *fifi_delta_native_index;
+
+/* The five entries the engine drives a machine through are rules, so the
+   shim declares each taking the machine as a value, the way every rule
+   does. The engine holds a pointer, so each gets a wrapper of the shape it
+   holds them in rather than a cast that would be a lie on a host where a
+   pointer is wider than a value. */
+extern int32_t fifi_DeltaProc_start(int32_t d);
+extern int32_t fifi_DeltaProc_end(int32_t d);
+extern int32_t fifi_DeltaProc_flush(int32_t d);
+extern int32_t fifi_DeltaProc_process_sentences(int32_t d);
+extern int32_t fifi_DeltaProc_process_remaining(int32_t d);
+extern int32_t fifi_DeltaProc_main(int32_t d);
+
+static int32_t proc_start(delta_state *d)
+{
+    return fifi_DeltaProc_start(EVV_REF(d));
+}
+
+static int32_t proc_end(delta_state *d)
+{
+    return fifi_DeltaProc_end(EVV_REF(d));
+}
+
+static int32_t proc_flush(delta_state *d)
+{
