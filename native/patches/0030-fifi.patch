+    &fifi_delta_sym_ref,
+
+    fifi_vstmtbl,
+    fifi_viasizes,
+
+    fifi_delta_globals,
+    0,                   /* how many */
+    fifi_delta_compounds,
+
+    fifi_link_new,
+    fifi_link_delete,
+    fifi_set_dict_new,
+    fifi_set_dict_delete,
+    fifi_act_dict_new,
+    fifi_act_dict_delete,
+
+    proc_start,
+    proc_end,
+    proc_flush,
+    proc_process_sentences,
+    proc_process_remaining,
+    proc_main,
+
+    0, 0,                /* the settings blob and its size */
+    1,                   /* settings sent only when changed */
+};
+
+void delta_lang_bind_fifi(void)
+{
+    delta_language *l = &delta_lang_fifi;
+
+    l->id             = fifi_eci_library_lang;
+    l->library_name   = fifi_eci_library_name;
+    l->state_bytes    = fifi_delta_state_bytes;
+    l->rule_sym_count = fifi_delta_rule_sym_count;
+    l->rule_count     = fifi_delta_rule_count;
+    l->rule_setjmp    = fifi_delta_rule_setjmp;
+    l->globals_n      = fifi_delta_globals_n;
+    l->codepoints_n   = fifi_delta_codepoints_n;
+    l->ini            = fifi_eciIni;
+    l->ini_size       = fifi_eciIniSize;
+}
