index 0000000..6a955a2
--- /dev/null
+++ b/lang/fifi/delta_codepoints_fifi.c
@@ -0,0 +1,21 @@
+/* Generated by tools/module/codepoints.py. Do not edit.
+
+   What each of fifi's own characters arrives as: the code point a caller
+   writes, and the byte the machine knows it by. Out of
+   lang/fifi/fifi.codepoints.
+
+   The engine asks the language in force before it falls back to the one
+   Windows Western list it has, which is where every character of the
+   languages IBM shipped already is. */
+
+#include <stdint.h>
+
+#include "delta_lang.h"
+
+/* None of its own: every character it has is in the
+   Western set the engine already knows. */
+const delta_codepoint fifi_delta_codepoints[] = {
+    { 0, 0 },
+};
+
+const int32_t fifi_delta_codepoints_n = 0;
diff --git a/lang/fifi/delta_consts_fifi.c b/lang/fifi/delta_consts_fifi.c
new file mode 100644
index 0000000..edbf2e4
--- /dev/null
+++ b/lang/fifi/delta_consts_fifi.c
@@ -0,0 +1,28 @@
+/* Generated by tools/rules/emit.py. Do not edit.
+
+   Everything the rules name by address: the language's
+   string constants and the compiler's own, as they lie in
+   the object each was compiled into.
+
+   A pronunciation changed in lang/fifi/fifi.dict is appended
+   here by tools/module/dict.py, which gives the edited
+   action a record of its own rather than writing over the
+   one it had, since several actions can name the same
+   bytes. Running this lifter again puts IBM's own back
+   and loses those edits. */
+
+#include <stdint.h>
+
+#include "delta_rules_fifi.h"
+
+/* Where each store is and how big, so that startup can
+   copy them somewhere a value can name. src/delta/delta_low.c is
+   the only reader: the machine holds addresses of these, and
+   an address in the program is not one a value can hold
+   unless the program was linked low, which a shared library
+   cannot be. sizeof rather than a number, so that a record
+   appended by tools/module/dict.py is counted without this
+   table being touched. */
+const delta_store fifi_delta_const_store[] = {
+    { 0, 0 },
+};
