+  if h_rax is not 0
+    go to pbb28d
+  end
+  place pbb9e2
+  call advance_tok
+  set h_rax to answer
+  if h_rax is 0
+    go to pbb9be
+  end
+  place pbb9ee
+  go to pbb28d
+  place pbb9f3
+  set h_rsi to 24
+  call bspush_ca_scan h_rsi
+  set h_rax to answer
+  set h_rsi to 1
+  set h_rdx to 1
+  set h_rcx to sym eti_s_f04aa
+  call test_string_s h_rsi h_rdx h_rcx
+  set h_rax to answer
+  set h_rcx to h_r15
+  if h_rax is not 0
+    go to pbb28d
+  end
+  place pbba1e
+  go to pbb687
+  place pbba23
+  place tbba23_1 on 1
+  set h_r15 to unwind
+  set h_rax to cell cf0 field
+  set h_rcx to arg 1
