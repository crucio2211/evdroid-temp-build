+# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
+# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
+# `instead' because it is written afresh rather than re-expressed from one of
+# IBM's: nothing of IBM's is under it.
+
+rule tok_dict takes 3
+  instead
+  local cf0 bytes 8
+  local c100 bytes 8
+  place pd57
+  place pd90
+  place pdee
+  call get_parm addr c100 arg 1 -6
+  call get_parm addr cf0 arg 2 -6
+  call fence 0 sym eti_null
+  if global half 3562 is not global half 3530
+    match
+  end
+  place pe34
+  call starttest_e 2
+  call bspush_ca_boa 3
+  call por_tok_dict addr c100 addr cf0
+  if answer is 0
+    set unwind to 1
+  end
+  if answer is not 0
+    set unwind to 0
+  end
+  backtrack
+  place pea6
+  place tea6_3 on 3
+  call bspop_boa
+  give up
+  place tm_1 on 1
+  place tm_2 on 2
+  match
+end
+
+rule char_name takes 3
+  instead
+  local cf0 bytes 8
+  local c100 bytes 8
+  place peb8
+  place pef1
+  place pf4f
+  call get_parm addr c100 arg 1 -6
+  call get_parm addr cf0 arg 2 -6
+  call fence 0 sym eti_null
+  if global half 3562 is not global half 3530
+    match
+  end
+  place pf95
+  call starttest_e 2
+  call bspush_ca_boa 3
+  call por_char_name addr c100 addr cf0
+  if answer is 0
+    set unwind to 1
+  end
+  if answer is not 0
+    set unwind to 0
+  end
+  backtrack
+  place p1007
+  place t1007_3 on 3
+  call bspop_boa
+  give up
+  place tm_1 on 1
+  place tm_2 on 2
+  match
+end
+
+rule abbr takes 4
+  instead
+  local c100 bytes 8
+  local c110 bytes 8
+  local c120 bytes 8
+  place p1019
+  place p1057
+  place p10b7
+  call get_parm addr c110 arg 1 -6
+  call get_parm addr c100 arg 2 -6
+  call get_parm addr c120 arg 3 -6
+  call fence 0 sym eti_null
+  if global half 3562 is not global half 3530
+    go to p116c
+  end
+  place p1112
+  call starttest_e 2
+  call bspush_ca_boa 3
+  call por_abbr addr c110 addr c100
+  if answer is 0
+    set unwind to 1
+  end
+  if answer is not 0
+    set unwind to 0
+  end
+  backtrack
+  place p116c
+  place t116c_1 on 1
+  place t116c_2 on 2
+  put cell c100 value into arg 2 at 4
+  match
+  place p118f
+  place t118f_3 on 3
+  call bspop_boa
+  give up
+end
+
+rule normalize_letters takes 3
+  instead
+  local cf0 bytes 8
+  local c100 bytes 8
+  place p11a1
+  place p11da
+  place p1234
+  call get_parm addr c100 arg 1 -6
+  call get_parm addr cf0 arg 2 -6
+  call fence 0 sym eti_null
+  if global half 3562 is not global half 3530
+    match
+  end
+  place p127a
+  call normalize_por_letters addr c100 addr cf0
+  match
+end
+
+rule monetary_exp takes 3
+  instead
+  local cf0 bytes 8
+  local c100 bytes 8
+  place p12a4
+  place p12dd
+  place p133b
