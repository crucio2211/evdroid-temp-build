DIAGNOSTIC: drop a final bang before intonation sees it

Drops a sentence-final ! (past trailing space and closers) in
addTextRun so the intonation rules never see the mark: what the
utterance sounds like with no bang intonation at all. Revert after
measuring (F0 + ear).

diff --git a/src/eci/synth/eci_synthtext.c b/src/eci/synth/eci_synthtext.c
index fb97f8e..918803f 100644
--- a/src/eci/synth/eci_synthtext.c
+++ b/src/eci/synth/eci_synthtext.c
@@ -421,6 +421,28 @@ THIS void addTextRun(SynthThread *t, char *text, uint32_t len, int32_t seq,
         goto counted;
     }
 
+    /* DIAGNOSTIC: drop a final ! before anything reads the text, so
+       intonation never sees the mark: past trailing space and closers,
+       a last ! shortens the run by one and nothing else changes. Revert
+       after measuring what the mark was doing. */
+    {
+        uint32_t end = len;
+
+        while (end > 0) {
+            unsigned char c = (unsigned char)text[end - 1];
+
+            if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '"'
+                || c == '\'' || c == ')' || c == ']' || c == '}')
+                end--;
+            else
+                break;
+        }
+        if (end > 0 && text[end - 1] == '!') {
+            len = end - 1;
+            asked = len;
+        }
+    }
+
     recodeForSSML(t, text, len, &mbcs_out, &mapped_out);
 
     /* And the way in for a language whose letters are not in the byte set
